<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_asset" model="ir.ui.view">
        <field name="name">product.template.form.asset</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="after">
                <group string="Asset Management" name="asset_management_group">
                    <field name="can_be_asset"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
