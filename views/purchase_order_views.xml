<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_asset_management" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.asset.management</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="asset_serial_number" optional="hide"/>
                <field name="asset_warranty_date" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='name']" position="after">
                <field name="asset_serial_number"/>
                <field name="asset_warranty_date"/>
            </xpath>
        </field>
    </record>
</odoo>
