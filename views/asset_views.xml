    <!-- Server Action for dynamic Assets entry logic (Warranty Check) -->
    <record id="action_asset_management_entry" model="ir.actions.server">
        <field name="name">Asset Management Entry</field>
        <field name="model_id" ref="asset_management.model_asset_management"/>
        <field name="state">code</field>
        <field name="code">
target_date = datetime.date.today() + datetime.timedelta(days=30)
domain = [('expired_warranty_date', '!=', False), ('expired_warranty_date', '&lt;=', target_date), ('asset_status', '!=', 'expired')]
expiring = env['asset.management'].search(domain, limit=1)

if expiring:
    wizard = env['asset.warranty.wizard'].create({'days_ahead': 30})
    action = env["ir.actions.actions"]._for_xml_id("asset_management.action_asset_warranty_wizard")
    action['res_id'] = wizard.id
else:
    action = env["ir.actions.actions"]._for_xml_id("asset_management.action_assets")
        </field>
    </record>

