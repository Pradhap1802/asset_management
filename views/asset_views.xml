<odoo>
    <!-- Form View for Asset Management -->
    <record id="view_asset_form" model="ir.ui.view">
        <field name="name">asset.management.form</field>
        <field name="model">asset.management</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Print Label" name="action_open_label_layout"
                            type="object" class="oe_highlight" icon="fa-print"
                            groups="asset_management.assets_user_group,asset_management.assets_admin_group,base.group_system"/>
                    <field name="asset_status" widget="statusbar"
                           statusbar_visible="active,maintenance_due,expired"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <!-- Title section with asset name -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- Main content organized in groups -->
                    <group>
                        <!-- Basic Information group -->
                        <group string="Basic Information">
                            <field name="product_id"/>
                            <field name="serial_number_ids" widget="many2many_tags" string="Serial Number / Barcode"/>
                            <field name="asset_type_id"/>
                            <field name="company_id" />
                            <field name="transfer_count"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="initial_stock" required="1"/>
                            <field name="current_stock"/>
                            <field name="active_transfers"/>
                        </group>
                        <!-- Financial Information group -->
                        <group string="Financial Information">
                            <field name="amount"/>
                            <field name="invoice_id"/>
                            <field name="invoice_date"/>
                            <field name="current_amount" readonly="1"/>
                            <field name="vendor_partner_id" readonly="1"/>
                            <field name="asset_status" readonly="1" decoration-info="asset_status == 'active'" decoration-danger="asset_status == 'expired'" widget="badge"/>
                        </group>
                        <!-- Depreciation Settings group -->
                        <group string="Depreciation Settings">
                            <field name="depreciation_apply"/>
                            <field name="total_depreciation_amount"/>
                            <field name="last_depreciation_date"/>
                            <field name="depreciation_count"/>
                        </group>
                        <!-- Maintenance & AMC Tracking -->
                        <group string="Maintenance &amp; AMC Tracking">
                            <field name="total_maintenance_amount" readonly="1"/>
                            <field name="maintenance_count"/>
                            <field name="total_downtime_days" readonly="1"/>
                        </group>
                        <!-- Asset Warranty group -->
                        <group string="Asset Warranty">
                            <field name="expired_warranty_date"/>
                        </group>
                        <!-- Documentation group -->
                        <group string="Documentation">
                            <field name="document_ids" widget="many2many_binary"/>
                        </group>
                    </group>

                    <!-- Notebook for additional details -->
                    <notebook>
                        <!-- Lifecycle Timeline Page -->
                        <page string="Lifecycle Timeline">
                            <group>
                                <group string="Key Dates">
                                    <field name="invoice_date" string="Purchase Date" readonly="1"/>
                                    <field name="capitalization_date"/>
                                    <field name="last_maintenance_date" readonly="1"/>
                                </group>
                                <group string="Upcoming / Expiry">
                                    <field name="next_maintenance_due" readonly="1"/>
                                    <field name="expired_warranty_date" string="Warranty Expiry" readonly="1"/>
                                    <field name="end_of_life_date"/>
                                </group>
                            </group>
                        </page>

                        <!-- Transfer Page -->
                        <page string="Transfer" groups="asset_management.transfer_user_group,base.group_system">
                            <field name="transfer_ids">
                                <list editable="bottom">
                                    <field name="transfer_code"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="serial_number_ids" widget="many2many_tags"
                                               domain="[('asset_id', '=', parent.id)]"
                                               string="Serial Numbers"/>
                                    <field name="transfer_employee_id"/>
                                    <field name="assign_date"/>
                                    <field name="assign_by"/>
                                    <field name="return_date"/>
                                    <field name="stock_qty"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <!-- Maintenance Page -->
                        <page string="Maintenance"
                              groups="asset_management.maintenance_user_group,base.group_system">
                            <field name="maintenance_ids">
                                <list editable="bottom">
                                    <field name="serial_number_id" domain="[('asset_id', '=', parent.id)]"/>
                                    <field name="maintenance_type"/>
                                    <field name="maintenance_vendor_id"/>
                                    <field name="assign_date"/>
                                    <field name="return_date"/>
                                    <field name="downtime_days" readonly="1"/>
                                    <field name="assign_by"/>
                                    <field name="maintenance_amount"/>
                                    <field name="invoice_id"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="document" filename="file_name"
                                           widget="binary"/>
                                    <field name="maintenance_status"/>
                                </list>
                            </field>
                        </page>

                        <!-- Depreciation Page -->
                        <page string="Depreciation" groups="asset_management.depreciation_user_group,base.group_system">
                            <field name="depreciation_ids">
                                <list editable="bottom">
                                    <field name="depreciation_amount"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="bill_id"/>
                                    <field name="created_by"/>
                                    <field name="entry_date"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <!-- Disposal Page -->
                        <page string="Disposals" groups="asset_management.assets_user_group,asset_management.assets_admin_group,base.group_system">
                            <field name="disposal_ids"
                                   readonly="1"
                                   views="[('list', 'asset_management.view_asset_disposal_inline_list')]">
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- list View for Asset Management -->
    <record id="view_asset_list" model="ir.ui.view">
        <field name="name">asset.management.list</field>
        <field name="model">asset.management</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button string="Print Labels" name="action_open_label_layout"
                            type="object"
                            icon="fa-print"
                            class="oe_highlight"
                            groups="asset_management.assets_user_group,asset_management.assets_admin_group,base.group_system"/>
                </header>
                <!-- Fields to display in the list view -->
                <field name="name"/>
                <field name="serial_number_ids" widget="many2many_tags" string="Serial Number / Barcode" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="asset_status" widget="badge" optional="show"
                       decoration-success="asset_status == 'active'"
                       decoration-warning="asset_status == 'maintenance_due'"
                       decoration-danger="asset_status == 'expired'"/>
                <field name="initial_stock" optional="show"/>
                <field name="current_stock" optional="show"/>
                <field name="active_transfers" optional="show"/>
                <field name="assigned_user"/>
                <field name="invoice_date"/>
                <field name="total_depreciation_amount"/>
                <field name="total_maintenance_amount"/>
                <field name="expired_warranty_date"/>
                <field name="remaining_warranty"/>
                <field name="depreciation_count"/>
                <field name="maintenance_count"/>
                <field name="transfer_count"/>
            </list>
        </field>
    </record>

    <!-- Search View for Asset Management -->
    <record id="view_asset_search" model="ir.ui.view">
        <field name="name">asset.management.search</field>
        <field name="model">asset.management</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="name"/>
                <field name="product_id"/>
                <field name="tag_ids"/>

                <filter string="Out of Stock" name="out_of_stock"
                        domain="[('current_stock', '&lt;=', 0)]"/>
                <filter string="In Stock" name="in_stock"
                        domain="[('current_stock', '&gt;', 0)]"/>
                <separator/>
                <filter string="Active" name="status_active"
                        domain="[('asset_status', '=', 'active')]"/>
                <filter string="Maintenance Due" name="status_maintenance_due"
                        domain="[('asset_status', '=', 'maintenance_due')]"/>
                <filter string="Expired / Scrap" name="status_expired"
                        domain="[('asset_status', '=', 'expired')]"/>

                <group>
                    <filter string="Asset Type" name="group_by_asset_type" context="{'group_by': 'asset_type_id'}"/>
                    <filter string="Tags" name="group_by_tags" context="{'group_by': 'tag_ids'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- Kanban View for Asset Management -->
    <record id="view_asset_kanban" model="ir.ui.view">
        <field name="name">asset.management.kanban</field>
        <field name="model">asset.management</field>
        <field name="arch" type="xml">
            <kanban default_group_by="asset_type_id" class="o_kanban_dashboard" multi_selection="1" create="1">
                <field name="id"/>
                <field name="name"/>
                <field name="asset_type_id"/>
                <field name="asset_status"/>
                <field name="barcode" invisible="1"/>
                <field name="amount"/>
                <field name="current_amount"/>
                <field name="invoice_date"/>
                <field name="expired_warranty_date"/>
                <field name="depreciation_count"/>
                <field name="maintenance_count"/>
                <field name="transfer_count"/>
                <field name="assigned_user"/>
                <field name="warranty_status"/>
                <field name="remaining_warranty"/>
                <field name="total_depreciation_amount"/>
                <field name="total_maintenance_amount"/>
                <field name="tag_ids"/>
                <field name="initial_stock"/>
                <field name="current_stock"/>
                <field name="active_transfers"/>
                <field name="product_id"/>
                <field name="company_id"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_card oe_kanban_content" role="article">
                            <!-- Card Header with Asset Name and Status -->
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="o_primary flex-grow-1">
                                            <strong class="text-truncate d-block" style="font-size: 1.1em;">
                                                <field name="name"/>
                                            </strong>
                                            <div class="text-muted text-truncate" style="font-size: 0.9em;" t-if="record.product_id.value">
                                                <field name="product_id"/>
                                            </div>
                                        </div>
                                        <!-- Asset Status Badge -->
                                        <div>
                                            <span t-if="record.asset_status.raw_value == 'active'" class="badge bg-success">🟢 Active</span>
                                            <span t-if="record.asset_status.raw_value == 'maintenance_due'" class="badge bg-warning text-dark">🟡 Maintenance Due</span>
                                            <span t-if="record.asset_status.raw_value == 'expired'" class="badge bg-danger">🔴 Expired/Scrap</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Card Body -->
                            <div class="o_kanban_card_content">
                                <!-- Asset Type Badge -->
                                <div class="mb-2" t-if="record.asset_type_id.raw_value">
                                    <span class="badge rounded-pill" 
                                          t-attf-class="badge rounded-pill #{record.asset_type_id.color and record.asset_type_id.color.raw_value ? 'o_tag_color_' + record.asset_type_id.color.raw_value : 'bg-secondary'} text-white">
                                        <i title="fa fa-tag me-1" aria-label="fa fa-tag me-1" class="fa fa-tag me-1"></i>
                                        <field name="asset_type_id"/>
                                    </span>
                                </div>
                                
                                <!-- Tags -->
                                <div class="mb-2" t-if="record.tag_ids.raw_value">
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                                
                                <!-- Serial Numbers -->
                                <div class="mb-2" t-if="record.serial_number_ids.raw_value">
                                    <div class="d-flex align-items-center text-muted">
                                        <i title="fa fa-barcode me-2" aria-label="fa fa-barcode me-2" class="fa fa-barcode me-2"></i>
                                        <field name="serial_number_ids" widget="many2many_tags"/>
                                    </div>
                                </div>
                                
                                <!-- Assigned User -->
                                <div class="mb-2" t-if="record.assigned_user.raw_value">
                                    <div class="d-flex align-items-center text-muted">
                                        <i title="fa fa-user me-2" aria-label="fa fa-user me-2" class="fa fa-user me-2"></i>
                                        <span class="text-truncate">
                                            <field name="assigned_user"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Stock Information -->
                                <div class="mb-2">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <span class="badge bg-info">
                                            <i title="fa fa-cubes me-1" aria-label="fa fa-cubes me-1" class="fa fa-cubes me-1"></i>
                                            Stock: <field name="current_stock"/>/<field name="initial_stock"/>
                                        </span>
                                        <span class="badge bg-warning text-dark" t-if="record.active_transfers.raw_value">
                                            <i title="fa fa-exchange me-1" aria-label="fa fa-exchange me-1" class="fa fa-exchange me-1"></i>
                                            Active: <field name="active_transfers"/>
                                        </span>
                                        <span t-if="record.company_id.raw_value" t-attf-class="badge rounded-pill o_tag_color_#{record.company_id.raw_value % 11} text-black">
                                            <i title="fa fa-building me-1" aria-label="fa fa-building me-1" class="fa fa-building me-1"></i>
                                            <field name="company_id"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Financial Information -->
                                <div class="mb-2">
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex justify-content-between align-items-center" t-if="record.amount.raw_value">
                                            <span class="text-muted small">
                                                <i title="fa fa-dollar-sign me-1" aria-label="fa fa-dollar-sign me-1" class="fa fa-dollar-sign me-1"></i>Purchase Price:
                                            </span>
                                            <strong><field name="amount" widget="monetary"/></strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center" t-if="record.current_amount.raw_value">
                                            <span class="text-muted small">
                                                <i title="fa fa-chart-line me-1" aria-label="fa fa-chart-line me-1" class="fa fa-chart-line me-1"></i>Book Value:
                                            </span>
                                            <strong class="text-primary"><field name="current_amount" widget="monetary"/></strong>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Dates -->
                                <div class="mb-2">
                                    <div class="d-flex flex-column gap-1 small">
                                        <div t-if="record.invoice_date.raw_value" class="text-muted">
                                            <i title="fa fa-calendar me-1" aria-label="fa fa-calendar me-1" class="fa fa-calendar me-1"></i>
                                            Purchase: <field name="invoice_date"/>
                                        </div>
                                        <div t-if="record.expired_warranty_date.raw_value" 
                                             t-attf-class="text-#{record.warranty_status.raw_value == 'expired' ? 'danger' : 'muted'}">
                                            <i title="fa fa-shield-alt me-1" aria-label="fa fa-shield-alt me-1" class="fa fa-shield-alt me-1"></i>
                                            Warranty: <field name="expired_warranty_date"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Card Footer with Statistics -->
                            <div class="o_kanban_record_bottom">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <span class="badge text-bg-secondary" title="Depreciation Entries">
                                            <i title="fa fa-chart-line me-1" aria-label="fa fa-chart-line me-1" class="fa fa-chart-line me-1"></i>
                                            <field name="depreciation_count"/>
                                        </span>
                                        <span class="badge text-bg-secondary" title="Maintenance Records">
                                            <i title="fa fa-wrench me-1" aria-label="fa fa-wrench me-1" class="fa fa-wrench me-1"></i>
                                            <field name="maintenance_count"/>
                                        </span>
                                        <span class="badge text-bg-secondary" title="Transfer History">
                                            <i title="fa fa-exchange me-1" aria-label="fa fa-exchange me-1" class="fa fa-exchange me-1"></i>
                                            <field name="transfer_count"/>
                                        </span>
                                    </div>
                                    <div t-if="record.remaining_warranty.raw_value">
                                        <span t-attf-class="badge 
                                            #{record.warranty_status.raw_value == 'expired' ? 'bg-danger' : 
                                              record.warranty_status.raw_value == 'expiring_soon' ? 'bg-warning text-dark' : 
                                              'bg-success'}">
                                            <i title="fa fa-shield-alt me-1" aria-label="fa fa-shield-alt me-1" class="fa fa-shield-alt me-1"></i>
                                            <field name="remaining_warranty"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- list View for Asset Transfer Entries -->
    <record id="view_asset_transfer_list" model="ir.ui.view">
        <field name="name">asset.transfer.list</field>
        <field name="model">asset.transfer.entry</field>
        <field name="arch" type="xml">
            <list>
                <!-- Fields displayed in the list view for asset transfers -->
                <field name="transfer_code"/>
                <field name="asset_id"/>
                <field name="product_id"/>
                <field name="serial_number_ids" widget="many2many_tags" string="Serial Numbers"/>
                <field name="from_branch_id"/>
                <field name="to_branch_id"/>
                <field name="transfer_employee_id"/>
                <field name="assign_date"/>
                <field name="assign_by"/>
                <field name="return_date"/>
                <field name="stock_qty"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- list View for Asset Maintenance Entries -->
    <record id="view_asset_maintenance_list" model="ir.ui.view">
        <field name="name">asset.maintenance.list</field>
        <field name="model">asset.maintenance.entry</field>
        <field name="arch" type="xml">
            <list>
                <!-- Fields displayed in the list view for asset maintenance -->
                <field name="asset_id"/>
                <field name="maintenance_vendor_id"/>
                <field name="product_id" string="Product / Equipment"/>
                <field name="maintenance_amount"/>
                <field name="assign_date"/>
                <field name="assign_by"/>
                <field name="return_date"/>
                <field name="maintenance_status"/>
            </list>
        </field>
    </record>

    <!-- Form View for Asset Maintenance Entries -->
    <record id="view_asset_maintenance_form" model="ir.ui.view">
        <field name="name">asset.maintenance.form</field>
        <field name="model">asset.maintenance.entry</field>
        <field name="arch" type="xml">
            <form string="Maintenance">
                <sheet>
                    <group>
                        <group string="Asset &amp; Equipment">
                            <field name="asset_id"/>
                            <field name="serial_number_id" domain="[('asset_id', '=', asset_id)]"/>
                            <field name="product_id" string="Product / Equipment"
                                   options="{'no_create': False}"
                                   help="Select the existing product from inventory used as maintenance equipment or spare part"/>
                            <field name="maintenance_vendor_id"/>
                        </group>
                        <group string="Service Details">
                            <field name="assign_date"/>
                            <field name="return_date"/>
                            <field name="assign_by"/>
                            <field name="maintenance_status"/>
                            <field name="maintenance_amount"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="file_name" invisible="1"/>
                        <field name="document" filename="file_name" widget="binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form View for Asset Transfer Entries -->
    <record id="view_asset_transfer_form" model="ir.ui.view">
        <field name="name">asset.transfer.form</field>
        <field name="model">asset.transfer.entry</field>
        <field name="arch" type="xml">
            <form string="Asset Transfer">
                <sheet>
                    <group>
                        <group string="Transfer Details">
                            <field name="transfer_code" readonly="1"/>
                            <field name="asset_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="serial_number_ids" widget="many2many_tags"
                                       domain="[('asset_id', '=', asset_id)]"
                                       string="Serial Numbers"/>
                            <field name="from_branch_id"/>
                            <field name="to_branch_id"/>
                            <field name="transfer_employee_id"/>
                            <field name="stock_qty"/>
                        </group>
                        <group string="Dates &amp; Status">
                            <field name="assign_date"/>
                            <field name="return_date"/>
                            <field name="assign_by"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Asset Depreciation Entries -->
    <record id="view_asset_depreciation_search" model="ir.ui.view">
        <field name="name">asset.depreciation.search</field>
        <field name="model">asset.depreciation.entry</field>
        <field name="arch" type="xml">
            <search string="Depreciation Entries">
                <field name="asset_id"/>
                <group>
                    <filter string="Asset Reference" name="group_by_asset" context="{'group_by': 'asset_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- list View for Asset Depreciation Entries -->
    <record id="view_asset_depreciation_list" model="ir.ui.view">
        <field name="name">asset.depreciation.list</field>
        <field name="model">asset.depreciation.entry</field>
        <field name="arch" type="xml">
            <list>
                <!-- Fields displayed in the list view for asset depreciation -->
                <field name="asset_id"/>
                <field name="product_id"/>
                <field name="bill_id"/>
                <field name="created_by"/>
                <field name="depreciation_amount"/>
                <field name="entry_date"/>
                <field name="state"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form View for Asset Depreciation Entries -->
    <record id="view_asset_depreciation_form" model="ir.ui.view">
        <field name="name">asset.depreciation.form</field>
        <field name="model">asset.depreciation.entry</field>
        <field name="arch" type="xml">
            <form string="Depreciation Entry">
                <sheet>
                    <group>
                        <group string="Asset Information">
                            <field name="asset_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="entry_date"/>
                            <field name="state"/>
                        </group>
                        <group string="Depreciation Details">
                            <field name="depreciation_amount"/>
                            <field name="bill_id"/>
                            <field name="created_by"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list View for Asset Tags -->
    <record id="view_asset_tag_list" model="ir.ui.view">
        <field name="name">asset.tag.list</field>
        <field name="model">asset.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- Form View for Asset Type -->
    <record id="view_asset_type_form" model="ir.ui.view">
        <field name="name">asset.type.form</field>
        <field name="model">asset.type</field>
        <field name="arch" type="xml">
            <form string="Asset Type">
                <sheet>
                    <group>
                        <!-- Fields for defining asset type characteristics -->
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="depreciation_frequency"/>
                        <field name="depreciation_method"/>
                        <field name="depreciation_rate"/>
                        <field name="depreciation_start_delay"/>
                        <field name="depreciation_basis"/>
                        <field name="maximum_depreciation_entries"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- list View for Asset Types -->
    <record id="view_asset_type_list" model="ir.ui.view">
        <field name="name">asset.type.list</field>
        <field name="model">asset.type</field>
