<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit from account.asset form view to add custom fields -->
    <record id="account_asset_form_inherit_asset_management" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.asset.management</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <!-- Asset Identification Fields -->
                <group string="Asset Identification">
                    <field name="asset_serial_number"/>
                    <field name="asset_warranty_date"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inject accounting_asset_id into asset.management form when Enterprise is available -->
    <record id="view_asset_form_inherit_accounting" model="ir.ui.view">
        <field name="name">asset.management.form.inherit.accounting</field>
        <field name="model">asset.management</field>
        <field name="inherit_id" ref="view_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_partner_id']" position="after">
                <field name="accounting_asset_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>