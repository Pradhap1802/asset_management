<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_dashboard_wizard_form" model="ir.ui.view">
        <field name="name">asset.dashboard.wizard.form</field>
        <field name="model">asset.dashboard.wizard</field>
        <field name="arch" type="xml">
            <form string="Asset Category Overview">
                <sheet>
                    <field name="summary_line_ids" readonly="1">
                        <list string="Asset Location Tracking" sortable="false" create="0" delete="0">
                            <field name="company_id" string="Location / Branch"/>
                            <field name="name" string="Asset Name"/>
                            <field name="count" string="Stock" sum="Total Stock"/>
                            <field name="original_value" string="Orig. Value" sum="Total Original"/>
                            <field name="current_value" string="Book Value" sum="Total Value"/>
                            <field name="depreciated_amount" string="Depreciated Amount" sum="Total Depreciated"/>
                            <field name="transfer_count" string="Transfers" sum="Total Transfers"/>
                            <field name="maintenance_count" string="Maint." sum="Total Maint."/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_dashboard_wizard" model="ir.actions.act_window">
        <field name="name">Asset Category Overview</field>
        <field name="res_model">asset.dashboard.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
